# Kconfig fragment for the a13ve recovery kernel.
#
# The validated recovery kernel is Samsung's plain a13ve_defconfig plus
# these two options (verified by diffing the config embedded in the built
# Image.gz against an expanded a13ve_defconfig: nothing else differs).
# Apply with:
#   cp patches/kernel/recovery.config <kernel>/arch/arm64/configs/
#   make O=out ARCH=arm64 a13ve_defconfig recovery.config
#
# The ramdisk built by this device tree is LZMA-compressed.
CONFIG_RD_LZMA=y
CONFIG_RD_LZ4=y
